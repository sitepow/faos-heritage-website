generator client {
  provider = "prisma-client-js"
}
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductUnit {
  PIECE
  ITEM
  SET
  BOX
  PACK
  BAG
  BOTTLE
  CAN
  KG
  G
  L
  ML
  PAIR
  ROLL
  SHEET
  UNIT
  CAR
  HOUSE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Currency {
  THB
  USD
  EUR
  ISK
  MYR
  SGD
  JPY
  CNY
  VND
  IDR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model BlogCategory {
  id        String  @id @default(cuid())
  slug      String  @unique
  name      String
  image     String?
  isActive  Boolean @default(true)

  posts         Post[]
  localizations BlogCategoryLocalization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model BlogCategoryLocalization {
  id             String @id @default(cuid())
  blogCategoryId String
  languageCode   String

  name           String

  blogCategory   BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, languageCode])
  @@index([blogCategoryId])
  @@index([languageCode])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  status    ReviewStatus @default(APPROVED) 

  postId    String?
  productId String?
  userId    String

  post      Post?     @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product?  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId  String?
  parent    Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[] @relation("CommentToComment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([productId])
  @@index([userId])
  @@index([parentId])
}

model Post {
  id      String @id @default(cuid())
  slug    String @unique
  authorId String

  title           String
  summary         String? @db.Text
  content         String? @db.Text 
  featuredImage   String?

  viewCount       Int     @default(0)
  isFeatured      Boolean @default(false)
  
  metaTitle       String? @db.Text
  metaDescription String? @db.Text
  keywords        String[] @default([])
  
  status          PostStatus @default(DRAFT)
  publishedAt     DateTime?
  
  categoryId      String?
  category        BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author          User          @relation(fields: [authorId], references: [id])
  
  tags            Tag[]         @relation("PostToTag")
  localizations   PostLocalization[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
}

model PostLocalization {
  id              String  @id @default(cuid())
  postId          String
  languageCode    String

  title           String
  summary         String? @db.Text
  content         String? @db.Text
  metaTitle       String? @db.Text
  metaDescription String? @db.Text
  keywords        String[] @default([])

  post            Post    @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, languageCode])
  @@index([postId])
  @@index([languageCode])
}

model Tag {
  id    String @id @default(cuid())
  name  String @unique
  slug  String @unique

  posts Post[] @relation("PostToTag")
  localizations TagLocalization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TagLocalization {
  id           String @id @default(cuid())
  tagId        String
  languageCode String
  name         String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageCode])
  @@index([tagId])
  @@index([languageCode])
}

model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique 
  url       String   @db.Text
  
  clicks    Int      @default(0)
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model ProductLocalization {
  id           String  @id @default(cuid())
  productId    String
  languageCode String
  
  name             String
  summary          String? @db.Text
  description      String? @db.Text
  metaTitle        String? @db.Text
  metaDescription  String? @db.Text
  keywords         String[] @default([])

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, languageCode])
  @@index([productId])
  @@index([languageCode])
}

model User {
  id String @id @default(cuid())

  email         String   @unique
  name          String?
  referrerCode  String? @unique
  password      String?
  image         String?
  emailVerified DateTime?
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart[]
  wishlist  Wishlist[]
  posts Post[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
  @@index([referrerCode])
}

model Address {
  id String @id @default(cuid())

  userId String
  isDefault Boolean @default(false)

  name        String
  phone       String
  address     String @db.Text
  district    String
  subDistrict String?
  province    String
  postalCode  String
  country     String
  countryCode String 

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String @id @default(cuid())
  slug        String? @unique
  name        String
  image       String?
  isActive    Boolean  @default(true)

  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products Product[]
  localizations CategoryLocalization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model CategoryLocalization {
  id           String @id @default(cuid())
  categoryId   String
  languageCode String

  name         String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageCode])
  @@index([categoryId])
  @@index([languageCode])
}

model Product {
  id                String @id @default(cuid())
  slug              String? @unique
  name              String  @unique
  summary           String? @db.Text
  description       String? @db.Text
  metaTitle         String? @db.Text
  metaDescription   String? @db.Text
  price             Decimal @db.Decimal(12, 2)
  salePrice         Decimal? @db.Decimal(12, 2)
  weight            Decimal? @db.Decimal(10, 3)
  stockQuantity Int @default(0)
  unit              ProductUnit @default(UNIT)
  keywords          String[] @default([])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  viewCount            Int @default(0)
  isActive             Boolean @default(true)

  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  orderItems   OrderItem[]
  cart         Cart[]
  wishlist     Wishlist[]
  stockHistory StockHistory[]
  localizations    ProductLocalization[]
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([categoryId, isActive])
  @@index([viewCount])
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  url       String
  alt       String?
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  image       String?
  name          String
  price         Decimal @db.Decimal(12, 2)
  salePrice     Decimal? @db.Decimal(12, 2)
  weight        Decimal @db.Decimal(10, 3)
  stockQuantity Int     @default(0)
  isActive      Boolean @default(true)
  options       Json?

  localizations ProductVariantLocalization[]

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockHistory StockHistory[]
  cart         Cart[] 

  @@index([productId])
  @@index([productId, isActive])
}

model ProductVariantLocalization {
  id               String         @id @default(cuid())
  productVariantId String
  languageCode     String
  name             String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, languageCode])
  @@index([productVariantId])
  @@index([languageCode])
}

model Cart {
  id String @id @default(cuid())

  userId    String
  productId String
  variantId String?

  quantity Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Wishlist {
  id String @id @default(cuid())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id String @id @default(cuid())

  userId              String?
  shippingAddressId   String?
  couponId            String?
  referrerCode        String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  // สกุลเงินที่ลูกค้าใช้ชำระเงิน
  currency      Currency @default(THB)
  exchangeRate Decimal @default(1) @db.Decimal(18, 8)
  exchangeLocale String?

  // ยอดเงินในสกุลเงินหลักของระบบ (Base Currency = THB)
  baseSubtotal    Decimal @db.Decimal(14, 2)
  baseDiscount    Decimal @db.Decimal(14, 2)
  baseTax         Decimal @db.Decimal(14, 2)
  baseShipping    Decimal @db.Decimal(14, 2)
  baseTotal       Decimal @db.Decimal(14, 2)

  // ยอดเงินในสกุลเงินที่ลูกค้าเลือก (ตามฟิลด์ currency)
  subtotal     Decimal @db.Decimal(14, 2)
  discount     Decimal @db.Decimal(14, 2)
  tax          Decimal @db.Decimal(14, 2)
  shippingCost Decimal @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)

  shippingName        String?
  shippingPhone       String?
  shippingAddressText String? @db.Text
  shippingMethod      String?
  trackingWebsite     String?
  trackingNumber      String?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  paymentMethod String?
  paidAt        DateTime?

  cancelledAt  DateTime?
  cancelReason String? @db.Text
  refundedAt   DateTime?

  couponCode String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ShippingCountry {
  id          String   @id @default(cuid())
  countryCode String   @unique
  countryName String
  currency    Currency @default(THB)
  isActive    Boolean  @default(true)

  baseRate    Decimal @db.Decimal(12, 2)
  pricePerKg  Decimal @db.Decimal(12, 2)

  freeShippingThreshold Decimal? @db.Decimal(12, 2)

  weightTiers ShippingWeightTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ShippingWeightTier {
  id                String @id @default(cuid())
  shippingCountryId String
  
  minWeight Decimal @db.Decimal(10, 3) 
  maxWeight Decimal @db.Decimal(10, 3)
  rate      Decimal @db.Decimal(12, 2)

  shippingCountry ShippingCountry @relation(fields: [shippingCountryId], references: [id], onDelete: Cascade)

  @@index([shippingCountryId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String?
  variantId String?

  currency Currency @default(THB)
  productName String
  variantName String?
  quantity    Int

  price    Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(14, 2)

  basePrice    Decimal @db.Decimal(12, 2)
  baseSubtotal Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model StockHistory {
  id String @id @default(cuid())

  productId String?
  variantId String?

  quantity  Int
  type      StockMovementType
  reference String?

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model Review {
  id String @id @default(cuid())

  productId String
  userId    String

  rating  Int
  title   String?
  comment String? @db.Text
  images  String[]
  status  ReviewStatus @default(PENDING)

  isVerifiedPurchase Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status])
}

model Coupon {
  id String @id @default(cuid())

  code          String @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal @db.Decimal(12, 2)
  minPurchase   Decimal @db.Decimal(12, 2)
  maxDiscount   Decimal @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([endDate])
}
