generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model PartnerApplication {
  id             String            @id @default(cuid())
  userId         String
  businessName   String
  businessType   String
  category       String
  website        String?
  description    String
  productSamples String
  reasonToJoin   String
  status         ApplicationStatus @default(PENDING)
  adminNote      String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  user           User              @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([status])
}

model PartnerSubscription {
  id             String     @id @default(cuid())
  storefrontId   String     @unique
  userId         String
  plan           PlanType   @default(STARTER)
  startDate      DateTime   @default(now())
  endDate        DateTime
  isActive       Boolean    @default(false)
  autoRenew      Boolean    @default(true)
  maxSku         Int        @default(5)
  commissionRate Decimal    @db.Decimal(5, 2)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  storefront     Storefront @relation(fields: [storefrontId], references: [id])
  user           User       @relation(fields: [userId], references: [id])

  @@index([storefrontId])
  @@index([endDate])
  @@index([userId])
}

model Contract {
  id             String         @id @default(cuid())
  storefrontId   String
  status         ContractStatus @default(DRAFT)
  startDate      DateTime       @default(now())
  endDate        DateTime?
  totalAmount    Decimal        @db.Decimal(14, 2)
  currency       Currency       @default(THB)
  mySignature    String?
  storeSignature String?
  signedAt       DateTime?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  profitType     ProfitType     @default(MARGIN)
  storefront     Storefront     @relation(fields: [storefrontId], references: [id])
  items          ContractItem[]
  orders         Order[]

  @@index([storefrontId])
  @@index([status])
  @@index([endDate])
}

model ContractItem {
  id          String          @id @default(cuid())
  contractId  String
  productId   String
  variantId   String?
  productName String
  variantName String?
  quantity    Int             @default(1)
  agreedPrice Decimal         @db.Decimal(12, 2)
  subtotal    Decimal         @db.Decimal(14, 2)
  contract    Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product     Product         @relation(fields: [productId], references: [id])
  variant     ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([contractId])
  @@index([productId])
}

model AffiliateCommission {
  id               String           @id @default(cuid())
  affiliateId      String
  orderId          String           @unique
  orderAmount      Decimal          @db.Decimal(12, 2)
  appliedRate      Decimal          @db.Decimal(5, 2)
  commissionAmount Decimal          @db.Decimal(12, 2)
  status           PayoutStatus     @default(PENDING)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  payoutId         String?
  affiliate        AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order            Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  payout           AffiliatePayout? @relation(fields: [payoutId], references: [id])

  @@index([affiliateId])
  @@index([status])
  @@index([payoutId])
}

model AffiliatePayout {
  id               String                @id @default(cuid())
  affiliateId      String
  amount           Decimal               @db.Decimal(12, 2)
  payoutProofImage String?
  status           PayoutStatus          @default(PENDING)
  notes            String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  commissions      AffiliateCommission[]
  affiliate        AffiliateProfile      @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  @@index([affiliateId])
  @@index([status])
}

model AffiliateProfile {
  id               String                @id @default(cuid())
  userId           String                @unique
  idCardImage      String?
  bankAccountImage String?
  bankName         String?
  bankAccountNo    String?
  socialMedia      String?
  phoneNumber      String?
  status           AffiliateStatus       @default(PENDING)
  baseRate         Decimal               @default(15.00) @db.Decimal(5, 2)
  highValueRate    Decimal               @default(20.00) @db.Decimal(5, 2)
  thresholdAmount  Decimal               @default(10000.00) @db.Decimal(12, 2)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  affiliateCode    String?               @unique
  bankAccountName  String?
  payoutEmail      String?
  payoutMethod     PayoutMethod          @default(THAI_BANK)
  walletAddress    String?
  walletNetwork    String?
  commissions      AffiliateCommission[]
  payouts          AffiliatePayout[]
  user             User                  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@index([affiliateCode])
}

model BlogCategory {
  id            String                     @id @default(cuid())
  slug          String                     @unique
  name          String
  image         String?
  isActive      Boolean                    @default(true)
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt
  localizations BlogCategoryLocalization[]
  posts         Post[]

  @@index([isActive])
}

model BlogCategoryLocalization {
  id             String       @id @default(cuid())
  blogCategoryId String
  languageCode   String
  name           String
  blogCategory   BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, languageCode])
  @@index([blogCategoryId])
  @@index([languageCode])
}

model Comment {
  id        String       @id @default(cuid())
  content   String
  status    ReviewStatus @default(APPROVED)
  postId    String?
  userId    String
  parentId  String?
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  productId String?
  parent    Comment?     @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies   Comment[]    @relation("CommentToComment")
  post      Post?        @relation(fields: [postId], references: [id], onDelete: Cascade)
  product   Product?     @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([postId])
  @@index([productId])
  @@index([userId])
  @@index([parentId])
}

model Faq {
  id            String            @id @default(cuid())
  slug          String            @unique
  localizations FaqLocalization[]
}

model FaqLocalization {
  id           String  @id @default(cuid())
  faqId        String
  languageCode String
  title        String?
  content      String?
  faq          Faq     @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, languageCode])
  @@index([faqId])
  @@index([languageCode])
}

model Post {
  id              String             @id @default(cuid())
  slug            String             @unique
  authorId        String
  title           String
  summary         String?
  content         String?
  featuredImage   String?
  viewCount       Int                @default(0)
  isFeatured      Boolean            @default(false)
  metaTitle       String?
  metaDescription String?
  status          PostStatus         @default(DRAFT)
  publishedAt     DateTime?
  categoryId      String?
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  keywords        String[]           @default([])
  comments        Comment[]
  author          User               @relation(fields: [authorId], references: [id])
  category        BlogCategory?      @relation(fields: [categoryId], references: [id])
  localizations   PostLocalization[]
  tags            Tag[]              @relation("PostToTag")

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
}

model PostLocalization {
  id              String   @id @default(cuid())
  postId          String
  languageCode    String
  title           String
  summary         String?
  content         String?
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])
  post            Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, languageCode])
  @@index([postId])
  @@index([languageCode])
}

model Tag {
  id            String            @id @default(cuid())
  name          String            @unique
  slug          String            @unique
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  localizations TagLocalization[]
  posts         Post[]            @relation("PostToTag")
}

model TagLocalization {
  id           String @id @default(cuid())
  tagId        String
  languageCode String
  name         String
  tag          Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageCode])
  @@index([tagId])
  @@index([languageCode])
}

model ShortLink {
  id        String   @id @default(cuid())
  code      String   @unique
  url       String
  clicks    Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model ProductLocalization {
  id              String   @id @default(cuid())
  productId       String
  languageCode    String
  name            String?
  summary         String?
  description     String?
  metaTitle       String?
  metaDescription String?
  keywords        String[] @default([])
  product         Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, languageCode])
  @@index([productId])
  @@index([languageCode])
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  name                 String?
  password             String?
  image                String?
  emailVerified        DateTime?
  isActive             Boolean               @default(true)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  referrerCode         String?               @unique
  roles                Role[]                @default([CUSTOMER])
  signature            String?
  addresses            Address[]
  affiliate            AffiliateProfile?
  cart                 Cart[]
  comments             Comment[]
  orders               Order[]
  partnerApplications  PartnerApplication[]
  partnerSubscriptions PartnerSubscription[]
  posts                Post[]
  reviews              Review[]
  stockHistory         StockHistory[]
  wishlist             Wishlist[]
  managedStorefronts   Storefront[]          @relation("StoreManagers")

  @@index([roles])
  @@index([isActive])
  @@index([createdAt])
  @@index([referrerCode])
}

model Address {
  id          String   @id @default(cuid())
  userId      String
  isDefault   Boolean  @default(false)
  name        String
  phone       String
  address     String
  district    String
  subDistrict String?
  province    String
  postalCode  String
  country     String
  countryCode String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders      Order[]

  @@index([userId])
}

model Category {
  id            String                 @id @default(cuid())
  name          String
  image         String?
  isActive      Boolean                @default(true)
  parentId      String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  slug          String?                @unique
  parent        Category?              @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[]             @relation("CategoryToCategory")
  localizations CategoryLocalization[]
  products      Product[]

  @@index([parentId])
  @@index([isActive])
}

model CategoryLocalization {
  id           String   @id @default(cuid())
  categoryId   String
  languageCode String
  name         String
  category     Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageCode])
  @@index([categoryId])
  @@index([languageCode])
}

model Product {
  id                    String                @id @default(cuid())
  name                  String                @unique
  summary               String?
  description           String?
  metaTitle             String?
  metaDescription       String?
  price                 Decimal               @db.Decimal(12, 2)
  weight                Decimal?              @db.Decimal(10, 3)
  unit                  ProductUnit           @default(UNIT)
  categoryId            String?
  isActive              Boolean               @default(true)
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  stockQuantity         Int                   @default(0)
  salePrice             Decimal?              @db.Decimal(12, 2)
  viewCount             Int                   @default(0)
  slug                  String?               @unique
  keywords              String[]              @default([])
  cart                  Cart[]
  comments              Comment[]
  contractItems         ContractItem[]
  orderItems            OrderItem[]
  category              Category?             @relation(fields: [categoryId], references: [id])
  images                ProductImage[]
  localizations         ProductLocalization[]
  variants              ProductVariant[]
  reviews               Review[]
  stockHistory          StockHistory[]
  storefrontInventories StorefrontInventory[]
  wishlist              Wishlist[]

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([categoryId, isActive])
  @@index([viewCount])
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  url       String
  alt       String?
  isPrimary Boolean @default(false)
  index     String?
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id                    String                       @id @default(cuid())
  productId             String
  image                 String?
  name                  String
  price                 Decimal                      @db.Decimal(12, 2)
  weight                Decimal                      @db.Decimal(10, 3)
  stockQuantity         Int                          @default(0)
  isActive              Boolean                      @default(true)
  options               Json?
  salePrice             Decimal?                     @db.Decimal(12, 2)
  cart                  Cart[]
  contractItems         ContractItem[]
  product               Product                      @relation(fields: [productId], references: [id], onDelete: Cascade)
  localizations         ProductVariantLocalization[]
  stockHistory          StockHistory[]
  storefrontInventories StorefrontInventory[]

  @@index([productId])
  @@index([productId, isActive])
}

model ProductVariantLocalization {
  id               String         @id @default(cuid())
  productVariantId String
  languageCode     String
  name             String
  productVariant   ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, languageCode])
  @@index([productVariantId])
  @@index([languageCode])
}

model Cart {
  id        String          @id @default(cuid())
  userId    String
  productId String
  variantId String?
  quantity  Int             @default(1)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  product   Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Wishlist {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Storefront {
  id                  String                @id @default(cuid())
  name                String                @unique
  description         String?
  image               String?
  phone               String?
  address             String
  googleMapUrl        String?
  latitude            Float?
  longitude           Float?
  businessHours       Json?
  isActive            Boolean               @default(true)
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  isMain              Boolean               @default(false)
  type                StorefrontType        @default(OWN_BRANCH)
  contracts           Contract[]
  orders              Order[]
  partnerSubscription PartnerSubscription?
  inventories         StorefrontInventory[]
  managers            User[]                @relation("StoreManagers")

  @@index([isActive])
}

model StorefrontInventory {
  id            String          @id @default(cuid())
  storefrontId  String
  productId     String
  variantId     String?
  stockQuantity Int             @default(0)
  retailPrice   Decimal         @db.Decimal(12, 2)
  netPrice      Decimal         @db.Decimal(12, 2)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  isActive      Boolean         @default(true)
  product       Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  storefront    Storefront      @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  variant       ProductVariant? @relation(fields: [variantId], references: [id])

  @@unique([storefrontId, productId, variantId])
  @@index([storefrontId, isActive])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id                  String               @id @default(cuid())
  userId              String?
  shippingAddressId   String?
  couponId            String?
  status              OrderStatus          @default(PENDING)
  paymentStatus       PaymentStatus        @default(PENDING)
  currency            Currency             @default(THB)
  exchangeRate        Decimal              @default(1) @db.Decimal(18, 8)
  exchangeLocale      String?
  baseSubtotal        Decimal              @db.Decimal(14, 2)
  baseDiscount        Decimal              @db.Decimal(14, 2)
  baseTax             Decimal              @db.Decimal(14, 2)
  baseShipping        Decimal              @db.Decimal(14, 2)
  baseTotal           Decimal              @db.Decimal(14, 2)
  subtotal            Decimal              @db.Decimal(14, 2)
  discount            Decimal              @db.Decimal(14, 2)
  tax                 Decimal              @db.Decimal(14, 2)
  shippingCost        Decimal              @db.Decimal(14, 2)
  total               Decimal              @db.Decimal(14, 2)
  shippingName        String?
  shippingPhone       String?
  shippingAddressText String?
  shippingMethod      String?
  trackingWebsite     String?
  trackingNumber      String?
  shippedAt           DateTime?
  deliveredAt         DateTime?
  paymentMethod       String?
  paidAt              DateTime?
  cancelledAt         DateTime?
  cancelReason        String?
  refundedAt          DateTime?
  couponCode          String?
  notes               String?
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  referrerCode        String?
  deliveryType        DeliveryType         @default(SHIPPING)
  pickupDate          DateTime?
  pickupStoreLocation String?
  storefrontId        String?
  contractId          String?
  isPos               Boolean              @default(false)
  affiliateCommission AffiliateCommission?
  contract            Contract?            @relation(fields: [contractId], references: [id])
  coupon              Coupon?              @relation(fields: [couponId], references: [id])
  address             Address?             @relation(fields: [shippingAddressId], references: [id])
  storefront          Storefront?          @relation(fields: [storefrontId], references: [id])
  user                User?                @relation(fields: [userId], references: [id])
  items               OrderItem[]
  stockHistories      StockHistory[]

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([deliveryType])
  @@index([storefrontId])
  @@index([contractId])
  @@index([isPos])
}

model ShippingCountry {
  id                    String               @id @default(cuid())
  countryCode           String               @unique
  countryName           String
  baseRate              Decimal              @db.Decimal(12, 2)
  pricePerKg            Decimal              @db.Decimal(12, 2)
  currency              Currency             @default(THB)
  isActive              Boolean              @default(true)
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  freeShippingThreshold Decimal?             @db.Decimal(12, 2)
  weightTiers           ShippingWeightTier[]

  @@index([isActive])
}

model ShippingWeightTier {
  id                String          @id @default(cuid())
  shippingCountryId String
  minWeight         Decimal         @db.Decimal(10, 3)
  maxWeight         Decimal         @db.Decimal(10, 3)
  rate              Decimal         @db.Decimal(12, 2)
  shippingCountry   ShippingCountry @relation(fields: [shippingCountryId], references: [id], onDelete: Cascade)

  @@index([shippingCountryId])
}

model OrderItem {
  id           String   @id @default(cuid())
  orderId      String
  productId    String?
  variantId    String?
  currency     Currency @default(THB)
  productName  String
  variantName  String?
  quantity     Int
  price        Decimal  @db.Decimal(12, 2)
  subtotal     Decimal  @db.Decimal(14, 2)
  basePrice    Decimal  @db.Decimal(12, 2)
  baseSubtotal Decimal  @db.Decimal(14, 2)
  netPrice     Decimal  @default(0) @db.Decimal(12, 2)
  netSubtotal  Decimal  @default(0) @db.Decimal(14, 2)
  order        Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product? @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
}

model StockHistory {
  id               String            @id @default(cuid())
  productId        String?
  variantId        String?
  quantity         Int
  type             StockMovementType
  reference        String?
  createdAt        DateTime          @default(now())
  location         String?
  note             String?
  userId           String?
  fromStorefrontId String?
  orderId          String?
  toStorefrontId   String?
  order            Order?            @relation(fields: [orderId], references: [id])
  product          Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  user             User?             @relation(fields: [userId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([fromStorefrontId])
  @@index([toStorefrontId])
  @@index([orderId])
}

model Review {
  id                 String       @id @default(cuid())
  productId          String
  userId             String
  rating             Int
  title              String?
  comment            String?
  images             String[]
  status             ReviewStatus @default(PENDING)
  isVerifiedPurchase Boolean      @default(false)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  product            Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user               User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status])
}

model Coupon {
  id            String       @id @default(cuid())
  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minPurchase   Decimal      @db.Decimal(12, 2)
  maxDiscount   Decimal      @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int          @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  orders        Order[]

  @@index([isActive])
  @@index([endDate])
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum PlanType {
  STARTER
  STANDARD
  PREMIUM
}

enum StorefrontType {
  OWN_BRANCH
  PARTNER_SHOP
  WAREHOUSE
}

enum PayoutMethod {
  THAI_BANK
  DIGITAL_WALLET
  PAYPAL
}

enum Role {
  CUSTOMER
  ADMIN
  STOCK_VIEWER
  STOCK_EDITOR
  POS
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  COMPLETED
  REJECTED
  PAID
}

enum ProductUnit {
  PIECE
  ITEM
  SET
  BOX
  PACK
  BAG
  BOTTLE
  CAN
  KG
  G
  L
  ML
  PAIR
  ROLL
  SHEET
  UNIT
  CAR
  HOUSE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
  READY_FOR_PICKUP
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  WITHDRAWAL
  TRANSFER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Currency {
  THB
  USD
  EUR
  ISK
  MYR
  SGD
  JPY
  CNY
  VND
  IDR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeliveryType {
  SHIPPING
  PICKUP
}

enum ContractStatus {
  DRAFT
  PENDING
  ACTIVE
