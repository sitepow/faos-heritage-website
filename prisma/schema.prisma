generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ApplicationStatus {
  PENDING
  REVIEWING
  APPROVED
  REJECTED
}

enum PlanType {
  STARTER
  STANDARD
  PREMIUM
}

enum StorefrontType {
  OWN_BRANCH
  PARTNER_SHOP
  WAREHOUSE
}

enum PayoutMethod {
  THAI_BANK
  DIGITAL_WALLET
  PAYPAL
}

enum Role {
  CUSTOMER
  ADMIN
  STOCK_VIEWER
  STOCK_EDITOR
  POS
}

enum AffiliateStatus {
  PENDING
  APPROVED
  REJECTED
  SUSPENDED
}

enum PayoutStatus {
  PENDING
  COMPLETED
  REJECTED
  PAID
}

enum ProductUnit {
  PIECE
  ITEM
  SET
  BOX
  PACK
  BAG
  BOTTLE
  CAN
  KG
  G
  L
  ML
  PAIR
  ROLL
  SHEET
  UNIT
  CAR
  HOUSE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  READY_FOR_PICKUP
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
  WITHDRAWAL
  TRANSFER
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Currency {
  THB
  USD
  EUR
  ISK
  MYR
  SGD
  JPY
  CNY
  VND
  IDR
}

enum PostStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum DeliveryType {
  SHIPPING
  PICKUP
}

enum ContractStatus {
  DRAFT
  PENDING
  ACTIVE
  EXPIRED
  TERMINATED
  ARCHIVED
}

model PartnerApplication {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id])

  businessName String
  businessType String
  category     String
  website      String?
  description  String  @db.Text

  productSamples String @db.Text
  reasonToJoin   String @db.Text

  status    ApplicationStatus @default(PENDING)
  adminNote String?           @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model PartnerSubscription {
  id           String     @id @default(cuid())
  storefrontId String     @unique
  storefront   Storefront @relation(fields: [storefrontId], references: [id])

  userId String
  user   User   @relation(fields: [userId], references: [id])

  plan      PlanType @default(STARTER)
  startDate DateTime @default(now())
  endDate   DateTime

  isActive  Boolean @default(false)
  autoRenew Boolean @default(true)

  maxSku         Int     @default(5)
  commissionRate Decimal @db.Decimal(5, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storefrontId])
  @@index([endDate])
  @@index([userId])
}

enum ProfitType {
  MARGIN
  AFFILIATE
}

model Contract {
  id           String     @id @default(cuid())
  storefrontId String
  storefront   Storefront @relation(fields: [storefrontId], references: [id])

  profitType ProfitType     @default(MARGIN)
  status     ContractStatus @default(DRAFT)

  startDate DateTime  @default(now())
  endDate   DateTime?

  totalAmount Decimal  @db.Decimal(14, 2)
  currency    Currency @default(THB)

  mySignature    String?
  storeSignature String?

  signedAt  DateTime?
  ipAddress String?
  userAgent String?

  items  ContractItem[]
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([storefrontId])
  @@index([status])
  @@index([endDate])
}

model ContractItem {
  id         String  @id @default(cuid())
  contractId String
  productId  String
  variantId  String?

  productName String
  variantName String?
  quantity    Int     @default(1)

  agreedPrice Decimal @db.Decimal(12, 2)
  subtotal    Decimal @db.Decimal(14, 2)

  contract Contract        @relation(fields: [contractId], references: [id], onDelete: Cascade)
  product  Product         @relation(fields: [productId], references: [id])
  variant  ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  @@index([contractId])
  @@index([productId])
}

model AffiliateCommission {
  id          String @id @default(cuid())
  affiliateId String
  orderId     String @unique

  payoutId String?
  payout   AffiliatePayout? @relation(fields: [payoutId], references: [id], onDelete: SetNull)

  orderAmount Decimal @db.Decimal(12, 2)

  appliedRate Decimal @db.Decimal(5, 2)

  commissionAmount Decimal @db.Decimal(12, 2)

  status PayoutStatus @default(PENDING)

  affiliate AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)
  order     Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
  @@index([payoutId])
}

model AffiliatePayout {
  id          String           @id @default(cuid())
  affiliateId String
  affiliate   AffiliateProfile @relation(fields: [affiliateId], references: [id], onDelete: Cascade)

  commissions AffiliateCommission[]

  amount           Decimal      @db.Decimal(12, 2)
  payoutProofImage String?
  status           PayoutStatus @default(PENDING)
  notes            String?      @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([affiliateId])
  @@index([status])
}

model AffiliateProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  affiliateCode String?         @unique
  status        AffiliateStatus @default(PENDING)

  phoneNumber String?
  socialMedia String? @db.Text

  idCardImage String?

  payoutMethod PayoutMethod @default(THAI_BANK)

  bankName         String?
  bankAccountNo    String?
  bankAccountName  String?
  bankAccountImage String?

  walletNetwork String?
  walletAddress String?

  payoutEmail String?

  baseRate        Decimal @default(15.00) @db.Decimal(5, 2)
  highValueRate   Decimal @default(20.00) @db.Decimal(5, 2)
  thresholdAmount Decimal @default(10000.00) @db.Decimal(12, 2)

  commissions AffiliateCommission[]
  payouts     AffiliatePayout[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([affiliateCode])
}

model BlogCategory {
  id       String  @id @default(cuid())
  slug     String  @unique
  name     String
  image    String?
  isActive Boolean @default(true)

  posts         Post[]
  localizations BlogCategoryLocalization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model BlogCategoryLocalization {
  id             String @id @default(cuid())
  blogCategoryId String
  languageCode   String

  name String

  blogCategory BlogCategory @relation(fields: [blogCategoryId], references: [id], onDelete: Cascade)

  @@unique([blogCategoryId, languageCode])
  @@index([blogCategoryId])
  @@index([languageCode])
}

model Comment {
  id      String       @id @default(cuid())
  content String       @db.Text
  status  ReviewStatus @default(APPROVED)

  postId    String?
  productId String?
  userId    String

  post    Post?    @relation(fields: [postId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  parentId String?
  parent   Comment?  @relation("CommentToComment", fields: [parentId], references: [id], onDelete: Cascade)
  replies  Comment[] @relation("CommentToComment")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([postId])
  @@index([productId])
  @@index([userId])
  @@index([parentId])
}

model Faq {
  id            String            @id @default(cuid())
  slug          String            @unique
  localizations FaqLocalization[]
}

model FaqLocalization {
  id           String  @id @default(cuid())
  faqId        String
  languageCode String
  title        String?
  content      String? @db.Text

  faq Faq @relation(fields: [faqId], references: [id], onDelete: Cascade)

  @@unique([faqId, languageCode])
  @@index([faqId])
  @@index([languageCode])
}

model Post {
  id       String @id @default(cuid())
  slug     String @unique
  authorId String

  title         String
  summary       String? @db.Text
  content       String? @db.Text
  featuredImage String?

  viewCount  Int     @default(0)
  isFeatured Boolean @default(false)

  metaTitle       String?  @db.Text
  metaDescription String?  @db.Text
  keywords        String[] @default([])

  status      PostStatus @default(DRAFT)
  publishedAt DateTime?

  categoryId String?
  category   BlogCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  author     User          @relation(fields: [authorId], references: [id])

  tags          Tag[]              @relation("PostToTag")
  localizations PostLocalization[]
  comments      Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([categoryId])
  @@index([status])
  @@index([publishedAt])
  @@index([isFeatured])
}

model PostLocalization {
  id           String @id @default(cuid())
  postId       String
  languageCode String

  title           String
  summary         String?  @db.Text
  content         String?  @db.Text
  metaTitle       String?  @db.Text
  metaDescription String?  @db.Text
  keywords        String[] @default([])

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@unique([postId, languageCode])
  @@index([postId])
  @@index([languageCode])
}

model Tag {
  id   String @id @default(cuid())
  name String @unique
  slug String @unique

  posts         Post[]            @relation("PostToTag")
  localizations TagLocalization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TagLocalization {
  id           String @id @default(cuid())
  tagId        String
  languageCode String
  name         String

  tag Tag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, languageCode])
  @@index([tagId])
  @@index([languageCode])
}

model ShortLink {
  id   String @id @default(cuid())
  code String @unique
  url  String @db.Text

  clicks Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([code])
}

model ProductLocalization {
  id           String @id @default(cuid())
  productId    String
  languageCode String

  name            String?
  summary         String?  @db.Text
  description     String?  @db.Text
  metaTitle       String?  @db.Text
  metaDescription String?  @db.Text
  keywords        String[] @default([])

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, languageCode])
  @@index([productId])
  @@index([languageCode])
}

model User {
  id String @id @default(cuid())

  email         String    @unique
  name          String?
  referrerCode  String?   @unique
  password      String?
  image         String?
  emailVerified DateTime?
  roles         Role[]    @default([CUSTOMER])
  isActive      Boolean   @default(true)

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart[]
  wishlist  Wishlist[]
  posts     Post[]
  comments  Comment[]

  stockHistory       StockHistory[]
  managedStorefronts Storefront[]   @relation("StoreManagers")
  signature          String?        @db.Text

  partnerApplications  PartnerApplication[]
  partnerSubscriptions PartnerSubscription[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliate AffiliateProfile?

  @@index([roles])
  @@index([isActive])
  @@index([createdAt])
  @@index([referrerCode])
}

model Address {
  id String @id @default(cuid())

  userId    String
  isDefault Boolean @default(false)

  name        String
  phone       String
  address     String  @db.Text
  district    String
  subDistrict String?
  province    String
  postalCode  String
  country     String
  countryCode String

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id       String  @id @default(cuid())
  slug     String? @unique
  name     String
  image    String?
  isActive Boolean @default(true)

  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products      Product[]
  localizations CategoryLocalization[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([parentId])
  @@index([isActive])
}

model CategoryLocalization {
  id           String @id @default(cuid())
  categoryId   String
  languageCode String

  name String

  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, languageCode])
  @@index([categoryId])
  @@index([languageCode])
}

model Product {
  id              String      @id @default(cuid())
  slug            String?     @unique
  name            String      @unique
  summary         String?     @db.Text
  description     String?     @db.Text
  metaTitle       String?     @db.Text
  metaDescription String?     @db.Text
  price           Decimal     @db.Decimal(12, 2)
  salePrice       Decimal?    @db.Decimal(12, 2)
  weight          Decimal?    @db.Decimal(10, 3)
  stockQuantity   Int         @default(0)
  unit            ProductUnit @default(UNIT)
  keywords        String[]    @default([])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  viewCount Int     @default(0)
  isActive  Boolean @default(true)

  images                ProductImage[]
  variants              ProductVariant[]
  reviews               Review[]
  orderItems            OrderItem[]
  cart                  Cart[]
  wishlist              Wishlist[]
  stockHistory          StockHistory[]
  localizations         ProductLocalization[]
  comments              Comment[]
  storefrontInventories StorefrontInventory[]
  contractItems         ContractItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([createdAt])
  @@index([categoryId, isActive])
  @@index([viewCount])
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  index     String?
  url       String
  alt       String?
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  image         String?
  name          String
  price         Decimal  @db.Decimal(12, 2)
  salePrice     Decimal? @db.Decimal(12, 2)
  weight        Decimal  @db.Decimal(10, 3)
  stockQuantity Int      @default(0)
  isActive      Boolean  @default(true)
  options       Json?

  localizations         ProductVariantLocalization[]
  storefrontInventories StorefrontInventory[]

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockHistory  StockHistory[]
  cart          Cart[]
  contractItems ContractItem[]

  @@index([productId])
  @@index([productId, isActive])
}

model ProductVariantLocalization {
  id               String @id @default(cuid())
  productVariantId String
  languageCode     String
  name             String

  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@unique([productVariantId, languageCode])
  @@index([productVariantId])
  @@index([languageCode])
}

model Cart {
  id String @id @default(cuid())

  userId    String
  productId String
  variantId String?

  quantity Int @default(1)

  user    User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Wishlist {
  id String @id @default(cuid())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Storefront {
  id           String         @id @default(cuid())
  name         String         @unique
  description  String?        @db.Text
  image        String?
  type         StorefrontType @default(OWN_BRANCH)
  phone        String?
  address      String         @db.Text
  googleMapUrl String?        @db.Text
  latitude     Float?
  longitude    Float?

  businessHours Json?

  isActive Boolean @default(true)
  isMain   Boolean @default(false)

  managers            User[]                @relation("StoreManagers")
  orders              Order[]
  inventories         StorefrontInventory[]
  contracts           Contract[]
  partnerSubscription PartnerSubscription?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model StorefrontInventory {
  id           String  @id @default(cuid())
  storefrontId String
  productId    String
  variantId    String?

  stockQuantity Int @default(0)

  retailPrice Decimal @db.Decimal(12, 2)

  netPrice Decimal @db.Decimal(12, 2)

  storefront Storefront      @relation(fields: [storefrontId], references: [id], onDelete: Cascade)
  product    Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant    ProductVariant? @relation(fields: [variantId], references: [id], onDelete: SetNull)

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([storefrontId, productId, variantId])
  @@index([storefrontId, isActive])
  @@index([productId])
  @@index([variantId])
}

model Order {
  id String @id @default(cuid())

  userId            String?
  shippingAddressId String?
  couponId          String?
  referrerCode      String?

  deliveryType DeliveryType @default(SHIPPING)

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)

  isPos Boolean @default(false)

  // สกุลเงินที่ลูกค้าใช้ชำระเงิน
  currency       Currency @default(THB)
  exchangeRate   Decimal  @default(1) @db.Decimal(18, 8)
  exchangeLocale String?

  // ยอดเงินในสกุลเงินหลักของระบบ (Base Currency = THB)
  baseSubtotal Decimal @db.Decimal(14, 2)
  baseDiscount Decimal @db.Decimal(14, 2)
  baseTax      Decimal @db.Decimal(14, 2)
  baseShipping Decimal @db.Decimal(14, 2)
  baseTotal    Decimal @db.Decimal(14, 2)

  // ยอดเงินในสกุลเงินที่ลูกค้าเลือก (ตามฟิลด์ currency)
  subtotal     Decimal @db.Decimal(14, 2)
  discount     Decimal @db.Decimal(14, 2)
  tax          Decimal @db.Decimal(14, 2)
  shippingCost Decimal @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)

  shippingName        String?
  shippingPhone       String?
  shippingAddressText String?   @db.Text
  shippingMethod      String?
  trackingWebsite     String?
  trackingNumber      String?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  pickupDate          DateTime?
  pickupStoreLocation String?
  storefrontId        String?
  storefront          Storefront? @relation(fields: [storefrontId], references: [id], onDelete: SetNull)

  paymentMethod String?
  paidAt        DateTime?

  cancelledAt  DateTime?
  cancelReason String?   @db.Text
  refundedAt   DateTime?

  couponCode String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  affiliateCommission AffiliateCommission?

  stockHistories StockHistory[]

  contractId String?
  contract   Contract? @relation(fields: [contractId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
  @@index([deliveryType])
  @@index([storefrontId])
  @@index([contractId])
  @@index([isPos])
}

model ShippingCountry {
  id          String   @id @default(cuid())
  countryCode String   @unique
  countryName String
  currency    Currency @default(THB)
  isActive    Boolean  @default(true)

  baseRate   Decimal @db.Decimal(12, 2)
  pricePerKg Decimal @db.Decimal(12, 2)

  freeShippingThreshold Decimal? @db.Decimal(12, 2)

  weightTiers ShippingWeightTier[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model ShippingWeightTier {
  id                String @id @default(cuid())
  shippingCountryId String

  minWeight Decimal @db.Decimal(10, 3)
  maxWeight Decimal @db.Decimal(10, 3)
  rate      Decimal @db.Decimal(12, 2)

  shippingCountry ShippingCountry @relation(fields: [shippingCountryId], references: [id], onDelete: Cascade)

  @@index([shippingCountryId])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String?
  variantId String?

  currency    Currency @default(THB)
  productName String
  variantName String?
  quantity    Int

  price    Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(14, 2)

  netPrice    Decimal @default(0) @db.Decimal(12, 2)
  netSubtotal Decimal @default(0) @db.Decimal(14, 2)

  basePrice    Decimal @db.Decimal(12, 2)
  baseSubtotal Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model StockHistory {
  id String @id @default(cuid())

  productId String?
  variantId String?
  orderId   String?

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  order  Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  quantity Int
  type     StockMovementType

  fromStorefrontId String?
  toStorefrontId   String?

  location  String? @db.Text
  note      String? @db.Text
  reference String?

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([userId])
  @@index([createdAt])
  @@index([type])
  @@index([fromStorefrontId])
  @@index([toStorefrontId])
  @@index([orderId])
}

model Review {
  id String @id @default(cuid())

  productId String
  userId    String

  rating  Int
  title   String?
  comment String?      @db.Text
  images  String[]
  status  ReviewStatus @default(PENDING)

  isVerifiedPurchase Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId])
  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status])
}

model Coupon {
  id String @id @default(cuid())

  code          String       @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal      @db.Decimal(12, 2)
  minPurchase   Decimal      @db.Decimal(12, 2)
  maxDiscount   Decimal      @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int          @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean      @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([endDate])
}
