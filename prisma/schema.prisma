generator client {
  provider = "prisma-client-js"
}
datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  ADMIN
}

enum ProductUnit {
  PIECE
  ITEM
  SET
  BOX
  PACK
  BAG
  BOTTLE
  CAN
  KG
  G
  L
  ML
  PAIR
  ROLL
  SHEET
  UNIT
  CAR
  HOUSE
}

enum OrderStatus {
  PENDING
  PAID
  PROCESSING
  DELIVERED
  CANCELLED
  REFUNDED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum StockMovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  RETURN
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

enum Currency {
  THB
  USD
  EUR
  ISK
  MYR
  SGD
  JPY
  CNY
  VND
  IDR
}

model Banner {
  id String @id @default(cuid())
  url String
  alt String?
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
}

model User {
  id String @id @default(cuid())

  email         String   @unique
  name          String?
  password      String?
  image         String?
  emailVerified DateTime?
  role          Role     @default(CUSTOMER)
  isActive      Boolean  @default(true)

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  cart      Cart[]
  wishlist  Wishlist[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([role])
  @@index([isActive])
  @@index([createdAt])
}

model Address {
  id String @id @default(cuid())

  userId String
  isDefault Boolean @default(false)

  name        String
  phone       String
  address     String @db.Text
  district    String
  subDistrict String?
  province    String
  postalCode  String
  country     String
  countryCode String 

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

model Category {
  id String @id @default(cuid())

  name        String
  slug        String?
  description String? @db.Text
  image       String?
  isActive    Boolean  @default(true)

  parentId String?
  parent   Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children Category[] @relation("CategoryToCategory")

  products Product[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([slug])
  @@index([parentId])
  @@index([isActive])
}

model Product {
  id String @id @default(cuid())

  name              String  @unique
  slug              String? @unique
  shortDescription  String? @db.Text
  description       String? @db.Text
  price             Decimal @db.Decimal(12, 2)
  compareAtPrice    Decimal? @db.Decimal(12, 2)
  costPrice         Decimal? @db.Decimal(12, 2)
  sku               String? @unique
  barcode           String?
  stockQuantity     Int     @default(0)
  lowStockAlert     Int     @default(10)
  weight            Decimal? @db.Decimal(10, 3)
  unit              ProductUnit @default(UNIT)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  isAuthentic          Boolean @default(true) 
  isPremiumProduct     Boolean @default(true)
  isActive             Boolean @default(true)
  isDigitalProduct     Boolean @default(false)
  isDemoProduct        Boolean @default(false)
  useSeoFromBasicData  Boolean @default(true)
  isFeatured           Boolean @default(false)

  images       ProductImage[]
  variants     ProductVariant[]
  reviews      Review[]
  orderItems   OrderItem[]
  cart         Cart[]
  wishlist     Wishlist[]
  stockHistory StockHistory[]

  metaTitle       String?
  metaDescription String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
  @@index([categoryId, isActive])
}

model ProductImage {
  id String @id @default(cuid())

  productId String

  url       String
  alt       String?
  isPrimary Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([productId, isPrimary])
}

model ProductVariant {
  id String @id @default(cuid())

  productId String

  image       String?
  name          String
  sku           String? @unique
  price         Decimal @db.Decimal(12, 2)
  weight        Decimal @db.Decimal(10, 3)
  stockQuantity Int     @default(0)
  isActive      Boolean @default(true)
  options       Json?

  product      Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockHistory StockHistory[]
  cart         Cart[] 

  @@index([productId])
  @@index([productId, isActive])
}

model Cart {
  id String @id @default(cuid())

  userId    String
  productId String
  variantId String?

  quantity Int @default(1)

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, productId, variantId])
  @@index([userId])
}

model Wishlist {
  id String @id @default(cuid())

  userId    String
  productId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id String @id @default(cuid())

  userId              String?
  shippingAddressId   String?
  couponId            String?

  status        OrderStatus   @default(PENDING)
  paymentStatus PaymentStatus @default(PENDING)
  currency      Currency @default(USD)
  shippingCurrency Currency @default(USD)
  exchangeRate Decimal @default(1) @db.Decimal(18, 8)
  exchangeRateSource String?
  exchangeLocale String?

  subtotalUsd     Decimal @db.Decimal(14, 2)
  discountUsd     Decimal @db.Decimal(14, 2)
  taxUsd          Decimal @db.Decimal(14, 2)
  shippingUsd     Decimal @db.Decimal(14, 2)
  totalUsd        Decimal @db.Decimal(14, 2)

  subtotal     Decimal @db.Decimal(14, 2)
  discount     Decimal @db.Decimal(14, 2)
  tax          Decimal @db.Decimal(14, 2)
  shippingCost Decimal @db.Decimal(14, 2)
  total        Decimal @db.Decimal(14, 2)

  shippingName        String?
  shippingPhone       String?
  shippingAddressText String? @db.Text
  shippingMethod      String?
  trackingWebsite     String?
  trackingNumber      String?
  shippedAt           DateTime?
  deliveredAt         DateTime?

  paymentMethod String?
  paidAt        DateTime?

  cancelledAt  DateTime?
  cancelReason String? @db.Text
  refundedAt   DateTime?

  couponCode String?
  coupon     Coupon? @relation(fields: [couponId], references: [id], onDelete: SetNull)

  user    User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  address Address?    @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items   OrderItem[]

  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model ShippingCountry {
  id String @id @default(cuid())

  countryCode String
  countryName String

  baseRate   Decimal @db.Decimal(12, 2)
  pricePerKg Decimal @db.Decimal(12, 2)
  currency Currency @default(USD)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([countryCode])
  @@index([isActive])
}

model ShippingWeightTier {
  id String @id @default(cuid())

  countryCode String

  minWeight  Decimal @db.Decimal(10, 3)
  maxWeight  Decimal @db.Decimal(10, 3)
  pricePerKg Decimal @db.Decimal(12, 2)

  @@unique([countryCode, minWeight, maxWeight])
  @@index([countryCode])
}

model OrderItem {
  id String @id @default(cuid())

  orderId   String
  productId String?
  variantId String?

  currency Currency @default(USD)
  productName String
  variantName String?
  sku         String?
  quantity    Int

  price    Decimal @db.Decimal(12, 2)
  subtotal Decimal @db.Decimal(14, 2)

  priceUsd    Decimal @db.Decimal(12, 2)
  subtotalUsd Decimal @db.Decimal(14, 2)

  order   Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product? @relation(fields: [productId], references: [id], onDelete: SetNull)

  @@index([orderId])
  @@index([productId])
}

model StockHistory {
  id String @id @default(cuid())

  productId String?
  variantId String?

  quantity  Int
  type      StockMovementType
  reference String?

  product Product?        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([productId])
  @@index([variantId])
  @@index([createdAt])
}

model Review {
  id String @id @default(cuid())

  productId String
  userId    String

  rating  Int
  title   String?
  comment String? @db.Text
  images  String[]
  status  ReviewStatus @default(PENDING)

  isVerifiedPurchase Boolean @default(false)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
  @@index([status])
  @@index([productId, status])
}

model Coupon {
  id String @id @default(cuid())

  code          String @unique
  description   String?
  discountType  DiscountType
  discountValue Decimal @db.Decimal(12, 2)
  minPurchase   Decimal @db.Decimal(12, 2)
  maxDiscount   Decimal @db.Decimal(12, 2)
  usageLimit    Int?
  usageCount    Int @default(0)
  startDate     DateTime
  endDate       DateTime
  isActive      Boolean @default(true)

  orders Order[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([endDate])
}
